NEWAPI_KEY=sk-your-own-key-here
NEWAPI_URL=https://newapi.elevatesphere.com
# Optional: dedicated gateway for Stage 2 image generation (gen_images.py). Falls
# back to NEWAPI_KEY/NEWAPI_URL if unset -- text writing, TTS, etc. always use
# NEWAPI_* regardless of these.
IMAGE_API_KEY=
IMAGE_API_URL=
COMFYUI_HOST=192.168.100.215
COMFYUI_MASTER_PORT=8188
COMFYUI_WORKER_PORTS=8189,8190,8191,8192,8193,8194,8195
COMFYUI_MAX_CONCURRENT=3

# Optional: only needed if you use these specific TTS backends.
FISHAUDIO_KEY=           # gen_tts_fishaudio.py -- cloned voices
ELEVENLABS_KEY=          # gen_tts_elevenlabs.py -- paid, more natural voices

# Optional: character-consistency verification (verify_character.py). Defaults
# below are what the scripts fall back to if unset -- uncomment only to change them.
# VERIFIER_MODEL=gemini-2.5-pro    # plain vision-in/text-out judge model
# MAX_GEN_ATTEMPTS=3               # 1 original + bounded corrective retries
# VERIFY_MODE=critical-only        # or "off" as an emergency low-credit fallback
